# Copy this file to .env in the same folder and fill in real values.
# .env itself must NEVER be committed (see .gitignore).
#
# Recommended: create a dedicated least-privilege MySQL user instead of
# reusing the Spring app's root credentials, e.g.:
#
#   CREATE USER 'network_analysis'@'localhost' IDENTIFIED BY '<choose-a-password>';
#   GRANT SELECT ON sentinel.transactions TO 'network_analysis'@'localhost';
#   GRANT SELECT ON sentinel.accounts TO 'network_analysis'@'localhost';
#   GRANT SELECT ON sentinel.payees TO 'network_analysis'@'localhost';
#   GRANT SELECT ON sentinel.cases TO 'network_analysis'@'localhost';
#   GRANT SELECT, INSERT, UPDATE ON sentinel.network_runs TO 'network_analysis'@'localhost';
#   GRANT SELECT, INSERT ON sentinel.account_network_scores TO 'network_analysis'@'localhost';
#   GRANT SELECT, UPDATE ON sentinel.network_run_requests TO 'network_analysis'@'localhost';
#   FLUSH PRIVILEGES;

NETWORK_DB_HOST=localhost
NETWORK_DB_PORT=3306
NETWORK_DB_NAME=sentinel
NETWORK_DB_USER=network_analysis
NETWORK_DB_PASSWORD=n3u3da!

NETWORK_POLL_INTERVAL_SECONDS=300
NETWORK_SCHEDULED_INTERVAL_MINUTES=60
